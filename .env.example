# ─────────────────────────────────────────────────────────────
# Hotel Booking API (https://github.com/tushar786940/Hotel-Booking-API)
# ─────────────────────────────────────────────────────────────
# Every endpoint lives under /api/v1 (routes/api.php → Route::prefix('v1')).
# All three of these values work — they are normalised to ".../api/v1":
#
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
#
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: call the API same-origin through Next's rewrite instead
# (no CORS). Set NEXT_PUBLIC_API_URL=/api and point the proxy at Laravel:
# NEXT_PUBLIC_API_URL=/api
# API_PROXY_TARGET=http://localhost:8000

# Where `php artisan storage:link` publishes uploaded images.
# Defaults to <api-origin>/storage.
NEXT_PUBLIC_STORAGE_URL=http://localhost:8000/storage
